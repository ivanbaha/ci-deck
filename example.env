# CI Deck configuration — entirely optional.
#
# Nothing here is required: start CI Deck and enter your GitLab URL and token in
# the UI, and they are kept in your OS credential store. This file exists for
# people who prefer configuration in files, and for automation.
#
# Copy to .env next to where you run CI Deck, or point at it with --env <path>.
# Never commit the real file: it holds a token that can act as you on GitLab.

# --- GitLab connection (optional; the UI can supply both) ---

# Personal access token, scope "api".
# "api" is needed rather than "read_api" because CI Deck retries and cancels jobs.
# Create one at <your GitLab>/-/user_settings/personal_access_tokens
# A token set here is used as-is and never written to the database.
# GITLAB_PAT='glpat-xxxxxxxxxxxxxxxxxxxx'

# Root URL of the GitLab instance — scheme and host only, no project path.
# Examples:
#   GITLAB_BASE_URL='https://gitlab.com/'
#   GITLAB_BASE_URL='https://gitlab.example.com/'
# GITLAB_BASE_URL='https://gitlab.com/'

# --- server (optional) ---

# Port for the local server. Overridden by --port. Default: 8787.
# The server always binds to 127.0.0.1 and cannot be exposed to the network.
# CI_DECK_PORT='8787'

# SQLite file holding the watch list, settings and credential reference.
# Overridden by --db. Defaults to the per-user data directory:
#   Windows  %LOCALAPPDATA%\ci-deck\ci-deck.db
#   macOS    ~/Library/Application Support/ci-deck/ci-deck.db
#   Linux    ~/.local/share/ci-deck/ci-deck.db
# CI_DECK_DB='./ci-deck.db'

# Values are merged per value, most explicit first:
#   inline (GITLAB_PAT=… ci-deck)  →  this file  →  what the UI saved
# The UI shows where each value came from, and will not let you edit one that
# the environment is dictating.
