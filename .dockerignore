# The build stage bundles `web/` itself, so a copy from the host would only risk
# being the stale one.
public/
dist/
node_modules/

.git/
.github/
tests/

# The release scans the image before it pushes it, and the scanner keeps its
# vulnerability database under the workspace. Nothing COPYs it, but without this
# the build that follows would upload the whole thing as context.
.cache/

# Local secrets and databases have no business in a build context.
.env
.env.*
!example.env
*.db
*.db-wal
*.db-shm

*.tgz
.*.bun-build
.DS_Store
.idea/
.vscode/
